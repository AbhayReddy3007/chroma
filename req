from chroma_main.gcs_lister import get_gcs_client, GCS_BUCKET_NAME, GCS_PATENTS_PREFIX

client = get_gcs_client()
prefix = GCS_PATENTS_PREFIX.rstrip("/") + "/"
blobs  = list(client.list_blobs(GCS_BUCKET_NAME, prefix=prefix))

folders = sorted({b.name.split("/")[len(prefix.split("/"))-1] for b in blobs if len(b.name.split("/")) > len(prefix.split("/"))})
print(folders)
